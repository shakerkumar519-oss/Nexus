# Copy this file to .env and edit as needed.

# Default: local SQLite file, zero setup, works out of the box for the SIH demo.
DATABASE_URL=sqlite:///./nexusguard.db

# To use PostgreSQL instead (matches the brief's target architecture), comment
# the line above and uncomment/edit this one:
# DATABASE_URL=postgresql://nexus_user:nexus_pass@localhost:5432/nexusguard

SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
